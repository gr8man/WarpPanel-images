FROM {{ image.base_image }}

LABEL maintainer="WarpPanel Team"
LABEL org.opencontainers.image.title="WarpPanel OpenLiteSpeed"
LABEL org.opencontainers.image.description="OpenLiteSpeed webserver with LSCache, QUIC, and proxy integration for WarpPanel"

RUN if command -v apk >/dev/null 2>&1; then \
        apk add --no-cache bash curl ca-certificates shadow tzdata; \
    elif command -v apt-get >/dev/null 2>&1; then \
        apt-get update && apt-get install -y --no-install-recommends bash curl ca-certificates tzdata && rm -rf /var/lib/apt/lists/*; \
    fi

ENV APP_DIR=/var/www/html \
    WEB_DOCUMENT_ROOT=/var/www/html/public \
    PUID=1000 \
    PGID=1000 \
    PHP_FPM_HOST=php-fpm \
    PHP_FPM_PORT=9000 \
    CLOUDFLARE_REAL_IP=1

WORKDIR /var/www/html

EXPOSE 80 443 7080 443/udp

CMD ["/usr/local/lsws/bin/openlitespeed", "-d"]
