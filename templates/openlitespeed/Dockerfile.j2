FROM {{ image.base_image }}

LABEL maintainer="WarpPanel Team"
LABEL org.opencontainers.image.title="WarpPanel OpenLiteSpeed (Alpine)"
LABEL org.opencontainers.image.description="OpenLiteSpeed webserver with LSCache, QUIC, and proxy integration for WarpPanel"

RUN apk add --no-cache \
    bash \
    curl \
    ca-certificates \
    shadow \
    tzdata

ENV APP_DIR=/var/www/html \
    WEB_DOCUMENT_ROOT=/var/www/html/public \
    PUID=1000 \
    PGID=1000 \
    PHP_FPM_HOST=php-fpm \
    PHP_FPM_PORT=9000 \
    CLOUDFLARE_REAL_IP=1

WORKDIR /var/www/html

EXPOSE 80 443 7080 443/udp

CMD ["/usr/local/lsws/bin/openlitespeed", "-d"]
