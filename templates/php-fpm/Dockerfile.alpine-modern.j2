FROM {{ image.base_image }}

LABEL maintainer="WarpPanel Team"
LABEL org.opencontainers.image.title="WarpPanel PHP-FPM {{ image.version }} (Alpine)"
LABEL org.opencontainers.image.description="High-performance, lightweight PHP-FPM container with Composer and Xdebug for WarpPanel"
LABEL org.opencontainers.image.version="{{ image.version }}"

# Install core system utilities & shadow (for dynamic usermod/groupmod)
RUN apk add --no-cache \
    bash \
    curl \
    ca-certificates \
    git \
    unzip \
    zip \
    msmtp \
    shadow \
    tzdata \
    icu-data-full

# Add official Docker PHP extension installer
COPY --from=mlocati/php-extension-installer:latest /usr/bin/install-php-extensions /usr/local/bin/

# Install full suite of WarpPanel hosting extensions (parallel multi-core compilation)
RUN chmod +x /usr/local/bin/install-php-extensions && \
    MAKEFLAGS="-j$(nproc)" install-php-extensions \
    bcmath \
    bz2 \
    calendar \
    exif \
    gd \
    gettext \
    gmp \
    igbinary \
    imagick \
{% if image.version not in ['8.4', '8.5'] %}
    imap \
{% endif %}
    intl \
    mbstring \
    mysqli \
    opcache \
    pcntl \
    pdo \
    pdo_mysql \
    pdo_pgsql \
    pdo_sqlite \
    pgsql \
    posix \
    redis \
    soap \
    sockets \
    sodium \
    sqlite3 \
    sysvmsg \
    sysvsem \
    sysvshm \
    xdebug \
    xsl \
    zip && \
{% if image.version in ['8.1', '8.2', '8.3'] %}
    if [ "$(uname -m)" = "x86_64" ]; then \
        install-php-extensions ioncube_loader || true; \
    fi && \
{% endif %}
    rm -rf /tmp/*

# Install Composer
COPY --from=composer:latest /usr/bin/composer /usr/local/bin/composer

# Setup standard directory structure (serversideup standard)
ENV APP_DIR=/var/www/html \
    WEB_DOCUMENT_ROOT=/var/www/html/public \
    PUID=1000 \
    PGID=1000 \
    COMPOSER_ALLOW_SUPERUSER=1 \
    COMPOSER_HOME=/tmp/composer \
    COMPOSER_MEMORY_LIMIT=-1 \
    PHP_XDEBUG_ENABLED=0

WORKDIR /var/www/html

# Copy entrypoint script
COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

EXPOSE 9000

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD ["php-fpm", "-F"]
