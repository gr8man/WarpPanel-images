FROM {{ image.base_image }}

LABEL maintainer="WarpPanel Team"
LABEL org.opencontainers.image.title="WarpPanel PHP-FPM {{ image.version }} (Alpine)"
LABEL org.opencontainers.image.description="High-performance, lightweight legacy PHP-FPM container with Composer and Xdebug for WarpPanel"
LABEL org.opencontainers.image.version="{{ image.version }}"

# Install core system utilities & shadow
RUN apk add --no-cache \
    bash \
    curl \
    ca-certificates \
    git \
    unzip \
    zip \
    msmtp \
    shadow \
    tzdata

# Add official Docker PHP extension installer
COPY --from=mlocati/php-extension-installer:latest /usr/bin/install-php-extensions /usr/local/bin/

# Install standard WarpPanel extensions (parallel multi-core compilation)
RUN chmod +x /usr/local/bin/install-php-extensions && \
    MAKEFLAGS="-j$(nproc)" install-php-extensions \
    bcmath \
    bz2 \
    calendar \
    exif \
    gd \
    gettext \
    gmp \
    imap \
    intl \
    mbstring \
    mysqli \
    opcache \
    pcntl \
    pdo \
    pdo_mysql \
    pdo_pgsql \
    pdo_sqlite \
    pgsql \
    posix \
    redis \
    soap \
    sockets \
    sqlite3 \
    xdebug \
    zip

# Install Composer (Composer 2.2 LTS for PHP 5.6-7.1, Composer latest for PHP 7.2+)
{% if image.version in ['5.6', '7.0', '7.1'] %}
COPY --from=composer:2.2 /usr/bin/composer /usr/local/bin/composer
{% else %}
COPY --from=composer:latest /usr/bin/composer /usr/local/bin/composer
{% endif %}

# Setup standard directory structure (serversideup standard)
ENV APP_DIR=/var/www/html \
    WEB_DOCUMENT_ROOT=/var/www/html/public \
    PUID=1000 \
    PGID=1000 \
    COMPOSER_ALLOW_SUPERUSER=1 \
    COMPOSER_HOME=/tmp/composer \
    COMPOSER_MEMORY_LIMIT=-1 \
    PHP_XDEBUG_ENABLED=0

WORKDIR /var/www/html

# Copy entrypoint script
COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

EXPOSE 9000

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD ["php-fpm", "-F"]
