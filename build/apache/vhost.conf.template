<VirtualHost *:80>
    ServerName localhost
    DocumentRoot "${RESOLVED_DOCUMENT_ROOT}"

    <Directory "${RESOLVED_DOCUMENT_ROOT}">
        Options -Indexes +FollowSymLinks
        AllowOverride All
        Require all granted
    </Directory>

    # Forward PHP requests to PHP-FPM
    <FilesMatch \.php$>
        SetHandler "proxy:fcgi://${PHP_FPM_BACKEND}"
    </FilesMatch>

    # Security WAF rules
    ${WAF_INCLUDE_LINE}

    # Health check
    Alias /healthz /var/www/html/healthz.txt
</VirtualHost>
